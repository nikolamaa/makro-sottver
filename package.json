{
  "name": "macropilot",
  "version": "0.1.0",
  "private": true,
  "description": "MacroPilot - local, encrypted, AI-assisted macro recommender for iGaming customer support agents",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/node/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "eval": "tsx scripts/eval-recommendations.ts",
    "recover": "node --disable-warning=ExperimentalWarning dist/node/server/recover.js",
    "setup": "npm install && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fastify/static": "^9.0.0",
    "csv-parse": "^6.1.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.5",
    "minisearch": "^7.2.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
